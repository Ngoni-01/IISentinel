# IISentinel — copy this file to .env in the backend/ folder
# (On Render: set these in the dashboard under Environment, no file needed)

# ── Edition (Microsoft-style modular licensing) ──
# net | tc | mc | cbs — comma separated. Unset = full Enterprise Suite
ENABLED_MODULES=net,tc,mc,cbs

# ── Core ──
DEMO_MODE=false
PRODUCTION=false
SECRET_KEY=change-me-to-something-random
# DATA_API_KEY=optional-key-to-lock-read-endpoints

# ── Email alerts (SMTP) ──
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IISentinel <alerts@yourdomain.com>
ALERT_EMAIL=ops@yourcompany.com

# ── SMS (Africa's Talking or Twilio) ──
# AT_API_KEY=
# AT_USERNAME=sandbox
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
ALERT_PHONE=+263771234567

# ── WhatsApp Business API ──
# WA_TOKEN=
# WA_PHONE_ID=
# WA_TO=+263771234567
