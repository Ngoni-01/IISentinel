# ─────────────────────────────────────────────────────────────
# Sentinel — environment configuration
#
# Copy to .env and edit. Every variable here is optional; the
# defaults shown are what the code uses if the variable is unset.
# .env is gitignored — never commit real values.
#
# There are NO credentials in this file. The admin password is
# generated randomly on first boot and printed once to the
# console; collector keys are issued through enrolment codes in
# the UI. Nothing secret needs to live in the environment.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────

# Port to listen on.
# Read by: run.py (development) and the Procfile / render.yaml
# start command (production, via gunicorn).
PORT=5000

# Where the SQLite database file lives.
# Default: sentinel.db in the project root.
# IMPORTANT for hosted deployments: point this at a PERSISTENT
# disk, or your findings and your admin account are wiped on
# every restart and first boot will mint a new password.
#   Render : /var/data/sentinel.db  (see render.yaml disk mount)
#   VPS    : /var/lib/sentinel/sentinel.db
# Read by: sentinel/storage/db.py
DB_PATH=sentinel.db


# ── Rate limits ──────────────────────────────────────────────
# Both are per-IP fixed windows. The defaults are deliberately
# tight; raise them only if you have a real reason.

# Enrolment attempts allowed per IP per 10 minutes.
# Default 10. Raise temporarily if you are enrolling many
# sensors at once, then put it back.
# Read by: sentinel/api/app.py
ENROL_LIMIT=10

# Scan submissions allowed per IP per minute.
# Default 120. One sensor reporting every 60s uses 1. Raise if
# you run many sensors behind a single NAT address.
# Read by: sentinel/api/app.py
SCAN_LIMIT=120


# ── Sensor side (set on the SENSOR machine, not the server) ───

# A collector key, as an alternative to the cached key file.
# Normally you do NOT set this: the sensor enrols once with a
# code from the UI and caches its key in ~/.sentinel-key.
# Useful for containerised or immutable sensor deployments.
# Read by: sensors/net_sensor.py, sensors/lan_probe.py
# SENTINEL_COLLECTOR_KEY=
