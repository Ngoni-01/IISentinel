[Unit]
Description=IISentinel Infrastructure Sentinel
After=network-online.target
Wants=network-online.target

[Service]
User=iis
WorkingDirectory=/opt/iisentinel
Environment=DB_PATH=/var/lib/iisentinel/iisentinel.db
Environment=DEMO_MODE=false
Environment=PRODUCTION=true
ExecStart=/opt/iisentinel/venv/bin/gunicorn app:app --workers 1 --threads 32 --worker-tmp-dir /dev/shm --keep-alive 5 --timeout 120 --bind 127.0.0.1:8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
